# Copy this file to .env and fill values locally. Never commit .env.
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
WEBHOOK_TOKEN=replace_with_a_long_random_secret
APP_HOST=127.0.0.1
APP_PORT=8000
MIN_AI_CONFIDENCE=65
AI_TIMEOUT_SECONDS=20
DATABASE_PATH=signals.db
